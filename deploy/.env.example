# Advanced stack in deploy/compose.yaml (local MusicBrainz + NetEase API).
# Copy to deploy/.env when using that file.

LIBRARY_HOST_PATH=/path/to/music
CONFIG_HOST_DIR=../config
DATA_HOST_PATH=../data

PUID=1000
PGID=1000
LYRA_PORT=48004
TZ=Asia/Shanghai
LYRA_VERSION=2.2.28

# Name of the external Docker network that provides the MusicBrainz mirror.
MUSICBRAINZ_NETWORK=musicbrainz_default

# Optional credentials.
# LYRA_LRCLIB_AUTHORIZATION_REF=
# LYRA_ACOUSTID_API_KEY=
# LYRA_ADMIN_PASSWORD=
