# Lyra 容器内配置模板
#
# 这份模板用**容器内路径**（/library、/data、/config）。
# 把它复制到宿主机的一个目录，再以只读方式挂进容器：
#
#   mkdir -p ./config
#   cp deploy/lyra.container.toml.example ./config/lyra.toml
#   $EDITOR ./config/lyra.toml
#
# 该文件含授权凭据，已在 .gitignore 中排除，请勿提交到公开仓库。

config_version = 1

[[roots]]
name = "library"
role = "library"
# 容器内路径。宿主机路径由 compose 的 LIBRARY_HOST_PATH 映射过来
path = "/library"
# 仅供 CLI/文档提示，不参与逻辑
host_path = ""
# 审计阶段可以改成 true 以彻底禁止写入
read_only = false
enabled = true
# 归置模式覆盖（空 = 继承 policy.organize.mode）：off / new_files / inbox
organize_mode = ""
# INBOX 根必配：入库处理后流转到哪个 library 根（按 name）；未配置只出建议
target_root = ""

[storage]
data_dir = "/data"

[network]
# 代理地址。用于访问境外服务（LRCLIB、MusicBrainz、AcoustID、大模型）。
# 支持 http://、https://、socks5://、socks5h://；留空表示不在配置里指定。
# 设置页保存的值优先于这里；两者都没有时才沿用系统环境变量
# HTTP_PROXY / HTTPS_PROXY / ALL_PROXY。
# 例：proxy = "http://10.0.1.8:7890"
proxy = ""

# 即使开了代理也直连的主机。自建的网易云 API、自建的 MusicBrainz 镜像都在内网。
direct_hosts = ["qq.com", "163.com", "126.net", "gtimg.cn"]

# 哪些功能经代理访问。国内来源（QQ、网易云）始终直连。
[network.use_proxy]
lrclib = true
musicbrainz = true
acoustid = true
cover = false

[watch]
backend = "auto"
# 等文件稳定再处理：慢速复制不会被提前处理
stable_seconds = 60
stable_samples = 3
reconcile_interval_seconds = 900
full_scan_local_time = "03:30"
timezone = "Asia/Shanghai"

[providers]
enabled = ["qq", "netease", "lrclib"]

[providers.qq]
# QQ 的可用性受地区和网络影响；部分地区会返回 500
# 直连被风控时可指向自建透明反代（替换 https://c.y.qq.com，路径与响应一致）；留空 = 直连
base_url = ""
minimum_request_interval_seconds = 2
query_limit_per_round = 3
candidates_per_query = 20
detail_and_lyric_limit_per_round = 6
max_inline_retries = 2
max_inline_retry_wait_seconds = 5

[providers.netease]
# 网易云音乐。歌词为毫秒精度 [00:00.000]。
# 与 QQ 的曲库覆盖并不重合，多一个来源多一次命中机会。
minimum_request_interval_seconds = 1.5
query_limit_per_round = 3
candidates_per_query = 20
detail_and_lyric_limit_per_round = 6
request_timeout_seconds = 20
max_inline_retries = 2
max_inline_retry_wait_seconds = 5

[providers.lrclib]
client_name = "Lyra"
client_version = "1.1.0"
client_url = "https://github.com/astralwaveorg/lyra"
# 授权 reference：优先用环境变量 LYRA_LRCLIB_AUTHORIZATION_REF 注入，
# 避免把凭据写进任何文件。留空表示只用客户端标识头（LRCLIB 不要求 key）。
authorization_ref = ""
minimum_request_interval_seconds = 0.5
max_backoff_seconds = 3600
circuit_breaker_threshold = 5
circuit_breaker_initial_seconds = 1800
max_inline_retries = 2
max_inline_retry_wait_seconds = 5

[providers.musicbrainz]
# 公共 API 每秒最多 1 次请求；自建镜像可把间隔调到 0.2 左右。
enabled = true
base_url = "https://musicbrainz.org"
minimum_request_interval_seconds = 1.1
request_timeout_seconds = 20
search_limit = 8
detail_limit = 3

[providers.acoustid]
# 声学指纹：缺 MBID 或有歧义时用音频本身确认录音。
# 需要镜像内的 fpcalc（Dockerfile 已安装）。
enabled = false
api_key = ""
base_url = "https://api.acoustid.org"

[policy]
# 已获明确授权自动写入；随时可设为 false 全局只读
write_enabled = true
write_mode = "auto"
# 内嵌与同名 .lrc 两者都写：多设备与 U 盘/车载需要文件自足
write_sidecar_lrc = true
embed_lyrics = true
# 0 字节/纯空白 .lrc 视为不存在，可安全填充
fill_empty_lrc = true
# 已有有效同步歌词则跳过（无收益只有风险）
skip_if_valid_synced = true
clear_plain_embedded = true
allow_other_providers = false

[policy.tags]
auto_scan = true
scan_interval_hours = 24
auto_write = true
fingerprint = true
max_auto_write_per_run = 2000
max_duration_delta_seconds = 5.0
# 低风险纠正自动写：强证据来源把英文标题纠正为中文（文字体系切换）
low_risk_auto_correct = true

[policy.matching]
# 时长闸门：识别版本差异的主要判据
max_duration_delta_seconds = 2
min_score_margin = 0.15
min_confidence = 0.75
# 时长差 ≤ 此值时，即使候选难分高下也直接接受（消除重复条目造成的假歧义）。
# 不绕过版本校验：时长相同不足以区分现场版/重生版。
auto_accept_within_seconds = 1.0
# 近似匹配：现场版可拿录音室词（AI 高置信判定同曲异版时自动采用）
allow_approximate = true

[policy.cover]
# 同目录规范命名图片（cover.jpg 等）自动嵌入；网络抓取默认只暂存待确认
auto_embed_sibling = true
fetch_sources = ["caa"]
min_min_pixels = 90000
auto_write = false

[policy.organize]
# 目录归置。默认 off = 只出建议不动文件；new_files 仅对新增文件自动归位
mode = "off"
template = "{artist}/{album}/{track_no} - {title}"

[retry]
not_found_intervals_days = [7, 30, 90]
no_synced_intervals_days = [30, 90, 180]
transient_backoff_seconds = [60, 300, 1800, 7200, 21600]

[lyrics]
encoding = "utf-8"
bom = false
line_ending = "lf"
format = "line_lrc"
# off=丢弃翻译；bilingual=双语文体；field=仅 FLAC 独立字段（true/false 旧写法兼容）
translation = "bilingual"
romanization = false
# 保留逐字歌词原文（QQ QRC）为同名 .qrc 文件
keep_word_level = false

[web]
# 容器内监听所有接口，宿主机只发布到回环，由反向代理对外提供 HTTPS
bind = "0.0.0.0"
port = 8080
auth_required = true
# 管理员凭据。
# 密码**刻意不写进源码**（源码会被提交、可能公开）。建议由这里或环境变量
# LYRA_ADMIN_PASSWORD 提供；两处都没有时才退化为随机密码并写入数据目录。
# 本文件含凭据，已在 .gitignore 中排除，请勿提交到公开仓库。
admin_username = "admin"
admin_password = ""

[write]
# 只给「人工确认过」的写入做整份备份。
# 自动接受（时长吻合+分数达标+标题艺人达标）的一类不做备份：写错概率低，
# 而每个文件整份复制代价极高（单个文件 24~142MB，全库可能十几 GB）。
# 置 false 即「凡是写入都备份」。
backup_review_only = true
backup_before_write = true
backup_auto_prune = false
backup_max_bytes = 0

[ai]
# AI 只做语义判断：「两份歌词是不是同一首歌、留哪一份」。
# Lyra 自己的匹配全靠可验证的证据（时长/版本/标题/艺人），但答不了
# 「两份看起来都像的歌词里，哪一份属于这首歌」——那只能看内容。
#
# 是否允许清理由**确定性**的歌词行覆盖决定（孤儿那份有没有多出歌词行），
# 不由模型一句话决定；动作是移入回收站（可还原），不是删除。
enabled = false
# openai_chat | openai_responses | anthropic
protocol = "openai_chat"
# 可填 base URL（含 /v1）或完整 endpoint
base_url = "https://api.openai.com/v1"
model = "gpt-4o-mini"
# 建议用环境变量 LYRA_AI_API_KEY 提供密钥，不要写进本文件
api_key = ""
timeout_seconds = 30.0
# 一轮最多问几次：既防超支，也防一次点击把上游打爆
max_requests_per_run = 12
# 高置信度的重复歌词是否自动清理（仍要求「歌词行 100% 被现有那份覆盖」）
auto_clean_duplicates = false
# 智能预审：对「待审查」候选调用模型判定（enabled=false 时无效）
pre_review = false
pre_review_confidence = 0.85
# 高置信判定直接自动采纳（留痕可撤销）
auto_accept = true
verify_tags = false
