# Copy to .env and edit. Docker Compose reads .env from this directory.

# Absolute path to the music library on the host. Required.
LIBRARY_HOST_PATH=/path/to/music

# Directory containing lyra.toml (mounted read-only).
CONFIG_HOST_DIR=./config

# Persistent data: database, backups, staging, trash. Must be outside the library.
DATA_HOST_PATH=./data

# Runtime identity. The image runs as 1000:1000 by default; set these to a user
# that can read and write the library.
PUID=1000
PGID=1000

# Host port. The service binds to 127.0.0.1 only; put a reverse proxy in front.
LYRA_PORT=8080

TZ=Asia/Shanghai

# Image tag. Pin a release for reproducible deployments.
LYRA_VERSION=2.2.22

# Admin account. Leave the password empty to generate a random one on first
# start; it is written to DATA_HOST_PATH/initial-password.txt. For automated
# deployments, provide a strong password here or through a secret manager.
LYRA_ADMIN_USERNAME=admin
# LYRA_ADMIN_PASSWORD=

# Optional credentials. Environment variables override lyra.toml.
# LYRA_LRCLIB_AUTHORIZATION_REF=
# LYRA_ACOUSTID_API_KEY=
# LYRA_AI_API_KEY=

# Build-time mirrors, only needed when the default registries are unreachable.
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
